
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Añadir película</title>
</head>
<body>
    <h1>Añadir una película</h1>

    <form action="/movie/new" method="POST">
        <label for="title">Título:</label>
        <input type="text" id="title" name="title" required>

        <br><br>

        <label for="year">Año:</label>
        <input type="number" id="year" name="year" min="1888" max="2027" required>

        <br><br>

        <label for="director">Director:</label>
        <input type="text" id="director" name="director" required>

        <br><br>

        <label for="duration">Duración (minutos):</label>
        <input type="number" id="duration" name="duration" required>

        <br><br>

        <label for="genre">Géneros (separados por comas):</label>
        <input type="text" id="genre" name="genre" required>

        <br><br>

        <label for="rate">Valoración:</label>
        <input type="number" id="rate" name="rate" min="0" max="10" step="0.1" required>

        <br><br>

        <label for="poster">URL del cartel:</label>
        <input type="url" id="poster" name="poster" required>

        <br><br>

        <button type="submit">Guardar película</button>
    </form>

    <p><a href="/">Volver al listado</a></p>
</body>
</html>
